---
interface Props {
  description: string;
}

const { description } = Astro.props;
---

<div
  class="w-full group p-0.5 bg-[#bb3e03]/15 dark:bg-[#006073]/30 rounded-lg relative myProjects"
>
  <span
    class="absolute inset-0 z-[1] rounded-lg opacity-0 transition duration-200"
  ></span>
  <div
    class="bg-gray-200 group-hover:bg-gray-200/95 dark:bg-[#001219] group-hover:dark:bg-[#001219]/90 rounded-lg h-full relative z-[2] flex flex-col"
  >
    <div class="p-2 grid place-content-center h-24 sm:h-full">
      <h3
        class="sm:text-lg font-semibold uppercase inline-flex text-gradient bg-gradient-to-r from-[#461500] via-[#f57d02] to-[#1b0900] dark:from-[#5ccdcf] dark:via-[#0a9396] dark:to-[#c4e6ec] bg-[200%_auto] bg-clip-text text-transparent"
      >
        {description}
      </h3>
    </div>
  </div>
</div>

<style>
  .text-gradient {
    animation: text-gradient 1.5s linear infinite;
  }

  @keyframes text-gradient {
    to {
      background-position: 200% center;
    }
  }
</style>
